{
  "editor.fontSize": 14,
  "editor.fontFamily": "'Cascadia Code', Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.rulers": [
    80,
    120
  ],
  "editor.renderWhitespace": "selection",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.linkedEditing": true,
  "editor.stickyScroll.enabled": true,
  "editor.minimap.renderCharacters": false,
  "editor.unicodeHighlight.nonBasicASCII": false,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.trimAutoWhitespace": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/node_modules": true,
    "**/bin": true,
    "**/obj": true,
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bin": true,
    "**/obj": true,
    "**/dist": true,
    "**/.cache": true
  },
  "explorer.compactFolders": false,
  "explorer.autoReveal": false,
  "workbench.iconTheme": "vscode-icons",
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": false,
  "workbench.editor.wrapTabs": true,
  "workbench.list.smoothScrolling": true,
  "workbench.editorAssociations": {
    "*.jpg": "default"
  },
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.fontFamily": "'Cascadia Code', 'Cascadia Mono', monospace",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.scrollback": 10000,
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "inlineChat.enableV2": true,
  "inlineChat.finishOnType": true,
  "inlineChat.hideOnRequest": true,
  "chat.sessionSync.enabled": true,
  "github.copilot.llm-gateway.serverUrl": "http://localhost:8111",
  "opilot.completionModel": "http://localhost:11434/v1",
  "opilot.experimental.nativeThinkingPart": true,
  "opilot.experimental.webSearch": true,
  "database-client.autoSync": true,
  "vscode-office.openOutline": false,
  "vscode-office.editorTheme": "Github Dark",
  "vscode-edge-devtools.browserFlavor": "Stable",
  "vscode-edge-devtools.webhint": false,
  "vscode-home-assistant.ignoreCertificates": true,
  "vscode-home-assistant.disableAutomaticFileAssociation": true,
  "google-translate.firstLanguage": "bg",
  "google-translate.secondLanguage": "en",
  "security.workspace.trust.untrustedFiles": "open",
  "security.allowedUNCHosts": [
    "pasevclaud",
    "homeassistant"
  ],
  "telemetry.telemetryLevel": "off",
  "chat.disableAIFeatures": true,
  "files.associations": {
    "*.db": "sqlite",
    "*.db3": "sqlite",
    "*.sqlite": "sqlite",
    "*.sqlite3": "sqlite",
    "*.sqlite2": "sqlite",
    "*.s3db": "sqlite",
    "*.sql": "sql"
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "powershell.startAutomatically": true
}

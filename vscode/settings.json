{
  "editor.fontSize": 14,
  "editor.fontFamily": "'Cascadia Code', Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.rulers": [
    80,
    120
  ],
  "editor.renderWhitespace": "selection",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.linkedEditing": true,
  "editor.stickyScroll.enabled": true,
  "editor.minimap.renderCharacters": false,
  "editor.unicodeHighlight.nonBasicASCII": false,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.trimAutoWhitespace": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/node_modules": true,
    "**/bin": true,
    "**/obj": true,
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bin": true,
    "**/obj": true,
    "**/dist": true,
    "**/.cache": true
  },
  "explorer.compactFolders": false,
  "explorer.autoReveal": false,
  "workbench.colorTheme": "Visual Studio Dark - C++",
  "workbench.iconTheme": "vscode-icons",
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": false,
  "workbench.editor.wrapTabs": true,
  "workbench.list.smoothScrolling": true,
  "workbench.editorAssociations": {
    "*.jpg": "default"
  },
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.fontFamily": "'Cascadia Code', 'Cascadia Mono', monospace",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.scrollback": 10000,
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "inlineChat.enableV2": true,
  "inlineChat.finishOnType": true,
  "inlineChat.hideOnRequest": true,
  "chat.sessionSync.enabled": true,
  "github.copilot.llm-gateway.serverUrl": "http://localhost:8111",
  "opilot.completionModel": "http://localhost:11434/v1",
  "opilot.experimental.nativeThinkingPart": true,
  "opilot.experimental.webSearch": true,
  "llama-vscode.env_start_last_used": true,
  "llama-vscode.tool_run_terminal_command_enabled": false,
  "llama-vscode.tool_search_source_enabled": false,
  "llama-vscode.tool_read_file_enabled": false,
  "llama-vscode.tool_list_directory_enabled": false,
  "llama-vscode.tool_regex_search_enabled": false,
  "llama-vscode.tool_delete_file_enabled": false,
  "llama-vscode.tool_get_diff_enabled": false,
  "llama-vscode.tool_edit_file_enabled": false,
  "llama-vscode.tool_ask_user_enabled": false,
  "llama-vscode.tool_custom_tool_enabled": false,
  "llama-vscode.tool_custom_eval_tool_enabled": false,
  "llama-vscode.tool_llama_vscode_help_enabled": false,
  "llama-vscode.tool_update_todo_list_enabled": false,
  "llama-vscode.tool_delegate_task_enabled": false,
  "llama-vscode.tool_create_agent_enabled": false,
  "llama-vscode.tool_get_errors_enabled": false,
  "llama-vscode.tool_rename_symbol_enabled": false,
  "llama-vscode.tool_multi_edit_file_enabled": false,
  "llama-vscode.tool_search_tools_enabled": false,
  "llama-vscode.completion_models_list": [
    {
      "name": "alloma",
      "localStartCommand": "llama serve -hf <model name from hugging face, i.e: ggml-org/Qwen2.5-Coder-1.5B-Q8_0-GGUF> -ub 1024 -b 1024 --ctx-size 0 --cache-reuse 256 --port 8012 --host 127.0.0.1",
      "endpoint": "http://127.0.0.1:8012",
      "aiModel": "",
      "isKeyRequired": false
    }
  ],
  "database-client.autoSync": true,
  "vscode-office.openOutline": false,
  "vscode-office.editorTheme": "Github Dark",
  "vscode-edge-devtools.browserFlavor": "Stable",
  "vscode-edge-devtools.webhint": false,
  "vscode-home-assistant.ignoreCertificates": true,
  "vscode-home-assistant.disableAutomaticFileAssociation": true,
  "docker.extension.dockerEngineAvailabilityPrompt": false,
  "vscodeGoogleTranslate.preferredLanguage": "English",
  "google-translate.firstLanguage": "bg",
  "google-translate.secondLanguage": "en",
  "security.workspace.trust.untrustedFiles": "open",
  "security.allowedUNCHosts": [
    "pasevclaud",
    "homeassistant"
  ],
  "telemetry.telemetryLevel": "off",
  "chat.disableAIFeatures": true,
  "files.associations": {
    "*.db": "sqlite",
    "*.db3": "sqlite",
    "*.sqlite": "sqlite",
    "*.sqlite3": "sqlite",
    "*.sqlite2": "sqlite",
    "*.s3db": "sqlite",
    "*.sql": "sql"
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "powershell.startAutomatically": true
}
